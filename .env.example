# APP_URL: URL donde está alojada la aplicación
APP_URL="http://localhost:3000"

# VITE_DOTNET_API_URL: URL base de la API .NET 10 (C#)
# Opción A (Recomendada para dev local con proxy Express): "/api"
# Opción B (Llamada directa a tu API en local): "http://localhost:5000/api" o "https://localhost:7001/api"
VITE_DOTNET_API_URL="/api"

# DOTNET_BACKEND_URL: URL de la API .NET 10 para el proxy de server.ts
# Si tu backend en C# corre en el puerto 5000 o 7001:
DOTNET_BACKEND_URL="http://localhost:7076/api"

# PUERTO local para el servidor (por defecto 3000)
PORT=3000
